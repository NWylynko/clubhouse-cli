# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY scripts/fetch-bundled-git.sh scripts/
RUN bash scripts/fetch-bundled-git.sh "linux-${TARGETARCH:-amd64}"

COPY . .

ARG VERSION=0.0.0-dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -ldflags "-s -w -X github.com/nwylynko/clubhouse-cli/cli.Version=${VERSION} -X github.com/nwylynko/clubhouse-cli/controlplane.ClientVersion=${VERSION}" \
    -o /out/club ./cmd/club

FROM debian:trixie

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git curl nodejs npm \
 && corepack enable || true \
 && rm -rf /var/lib/apt/lists/*

ARG VERSION=0.0.0-dev
ARG REVISION=unknown

LABEL org.opencontainers.image.title="clubhouse-box" \
      org.opencontainers.image.description="Clubhouse cloud dev box — hosts a session canonical and supervises the dev server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/nwylynko/clubhouse-cli"

COPY --from=build /out/club /usr/local/bin/club
RUN chmod +x /usr/local/bin/club \
 && club --version \
 && club --version | grep -qF "${VERSION}"

WORKDIR /home/club
ENTRYPOINT ["club"]
CMD ["--help"]
